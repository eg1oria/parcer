POSTGRES_DB=testprep
POSTGRES_USER=testprep
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=1d

NEXT_PUBLIC_API_URL=/api
RAW_IMPORT_MAX_CHARS=100000
MAX_UPLOAD_FILE_SIZE_BYTES=10485760
MAX_REQUEST_BODY_SIZE_BYTES=1048576
HOST_IMPORTED_IMAGE_STORAGE_PATH=./backend/.tmp/imported-tests
IMPORTED_IMAGE_STORAGE_PATH=/app/.tmp/imported-tests
PDF_IMAGE_EXTRACTION_TIMEOUT_MS=15000
PDF_TEXT_EXTRACTION_TIMEOUT_MS=30000
PDF_RICH_EXTRACTION_ENABLED=true
