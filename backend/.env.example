DATABASE_URL="postgresql://testprep:testprep@localhost:5432/testprep?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MS=600000
RAW_IMPORT_MAX_CHARS=100000
MAX_UPLOAD_FILE_SIZE_BYTES=10485760
MAX_REQUEST_BODY_SIZE_BYTES=1048576
IMPORTED_IMAGE_STORAGE_PATH=.tmp/imported-tests
PDF_IMAGE_EXTRACTION_TIMEOUT_MS=15000
PDF_IMAGE_CACHE_MAX_ENTRIES=256
PDF_TEXT_EXTRACTION_TIMEOUT_MS=30000
PDF_RICH_EXTRACTION_ENABLED=true
