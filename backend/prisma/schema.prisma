generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TestType {
  SINGLE_CHOICE
}

enum UploadedFileStatus {
  PROCESSED
  FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  uploadedFiles UploadedFile[]
  tests         Test[]
  attempts      Attempt[]
}

model UploadedFile {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  originalName  String
  mimeType      String
  size          Int
  extractedText String             @db.Text
  status        UploadedFileStatus @default(PROCESSED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tests         Test[]

  @@index([userId])
  @@index([status])
}

model Test {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  title        String
  sourceFileId String?       @db.Uuid
  type         TestType      @default(SINGLE_CHOICE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFile   UploadedFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  questions    Question[]
  attempts     Attempt[]

  @@index([userId])
  @@index([sourceFileId])
}

model Question {
  id             String          @id @default(uuid()) @db.Uuid
  testId         String          @db.Uuid
  text           String
  imageUrls      String[]        @default([])
  order          Int
  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  variants       Variant[]
  attemptAnswers AttemptAnswer[]

  @@index([testId])
  @@unique([testId, order])
}

model Variant {
  id             String          @id @default(uuid()) @db.Uuid
  questionId     String          @db.Uuid
  text           String
  imageUrls      String[]        @default([])
  isCorrect      Boolean         @default(false)
  order          Int
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@index([questionId])
  @@unique([questionId, order])
}

model Attempt {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String?         @db.Uuid
  testId    String          @db.Uuid
  guestName String?
  score     Int
  total     Int
  percent   Float
  createdAt DateTime        @default(now())
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  test      Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers   AttemptAnswer[]

  @@index([userId])
  @@index([testId])
}

model AttemptAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @db.Uuid
  questionId        String   @db.Uuid
  selectedVariantId String   @db.Uuid
  isCorrect         Boolean
  attempt           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedVariant   Variant  @relation(fields: [selectedVariantId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@index([selectedVariantId])
}
